#!/usr/bin/env bash
# Imports GPG + SSH private keys from 1Password if vault refs are configured
# in .chezmoi.toml. Re-runs whenever the rendered content changes.
#
# Config hash: {{ list .gpgSigningKey .opGpgRef .opSshRef | toString | sha256sum }}

set -euo pipefail

{{- if and (not .opGpgRef) (not .opSshRef) }}
# No 1Password refs configured; nothing to import.
exit 0
{{- else }}

if ! command -v op &>/dev/null; then
  echo "1Password CLI (op) not found on PATH. Brew bundle should have installed it —"
  echo "  run \`chezmoi apply\` once the install script has completed."
  exit 0
fi

if ! op whoami &>/dev/null; then
  echo "1Password CLI is installed but not signed in."
  echo "  Open the 1Password app, enable CLI integration in Settings → Developer,"
  echo "  then re-run: chezmoi apply"
  exit 0
fi

{{- if .opGpgRef }}

# GPG private key
{{- if .gpgSigningKey }}
if ! gpg --list-secret-keys "{{ .gpgSigningKey }}" &>/dev/null; then
  echo "Importing GPG private key {{ .gpgSigningKey }} from 1Password..."
  op read "{{ .opGpgRef }}" | gpg --import
fi
{{- else }}
if [[ -z "$(gpg --list-secret-keys --with-colons 2>/dev/null | grep '^sec:')" ]]; then
  echo "Importing GPG private key from 1Password..."
  op read "{{ .opGpgRef }}" | gpg --import
fi
{{- end }}
{{- end }}

{{- if .opSshRef }}

# SSH private key
SSH_KEY="$HOME/.ssh/id_ed25519"
if [[ ! -f "$SSH_KEY" ]]; then
  echo "Restoring SSH private key from 1Password to $SSH_KEY..."
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  umask 077
  op read "{{ .opSshRef }}" > "$SSH_KEY"
  chmod 600 "$SSH_KEY"
fi
{{- end }}

{{- end }}
