#!/usr/bin/env bash
# Scans staged changes for credentials before they reach a commit.
#
# Enabled by scripts/install-hooks.sh, which sets core.hooksPath to .githooks.
#
# This catches what review can't: a token or key is high-entropy noise, and
# noise is what you skim past. This repo is small and mostly config, which is
# exactly the kind of place a stray key gets pasted "just for a second".

set -euo pipefail

if ! command -v gitleaks &>/dev/null; then
  echo "gitleaks is not installed, so staged changes were not scanned."
  echo "  brew install gitleaks"
  echo
  echo "Commit blocked rather than silently unscanned. If you are certain this"
  echo "change is clean: git commit --no-verify"
  exit 1
fi

if ! gitleaks protect --staged --redact --no-banner; then
  echo
  echo "gitleaks found a potential secret in the staged changes."
  echo
  echo "Move the value to a machine-local file instead — none are tracked:"
  echo "  ~/.zshrc.local                   shell aliases and functions"
  echo "  ~/.zshenv.local                  environment variables"
  echo "  ~/.ssh/config.local              per-host ssh settings"
  echo "  ~/.config/git/local.gitconfig    remotes and url rewrites"
  echo
  echo "Override only if you are certain: git commit --no-verify"
  exit 1
fi
