[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version=refname
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[push]
    default = simple
    autoSetupRemote = true
    followTags = true
[fetch]
    prune = true
    pruneTags = true
    all = true
[help]
    autocorrect = prompt
[commit]
    verbose = true
{{- if .gpgSigningKey }}
    gpgsign = true
{{- end }}
[rerere]
    enabled = true
    autoupdate = true
[core]
    excludesfile = ~/.gitignore
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[user]
    email = {{ .email }}
    name = {{ .name }}
{{- if .gpgSigningKey }}
    signingkey = {{ .gpgSigningKey }}
{{- end }}
[github]
    user = dimitri-kandassamy
[init]
	defaultBranch = main
