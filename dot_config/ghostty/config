# Ghostty — https://ghostty.org
#
# Plain text, unlike the binary plist iTerm2 keeps its settings in, so changes
# here show up as reviewable diffs. Run `ghostty +list-themes` to browse themes
# and `ghostty +show-config --default --docs` for every option with its docs.

# ------------------------------------------------------------------ appearance
theme = catppuccin-mocha
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-save-state = always
window-colorspace = display-p3

background-opacity = 1.0
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ------------------------------------------------------------------- behaviour
# Treat Option as Alt so Alt+C (fzf's directory jump) and Alt+B/F word motions
# work. Costs the Option-key accent composition, which is not used here.
macos-option-as-alt = true

# Ghostty starts a login shell by default, which is what puts Homebrew on PATH
# via ~/.zprofile. Left explicit so it survives a change of defaults upstream.
command = /bin/zsh --login

scrollback-limit = 10000000
copy-on-select = clipboard
confirm-close-surface = true
quit-after-last-window-closed = true

# Shell integration gives Ghostty prompt marks, working-directory inheritance on
# new splits, and correct cursor shape reporting.
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ------------------------------------------------------------------- keybinds
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+enter=toggle_split_zoom
keybind = cmd+k=clear_screen
