# Sourced by ~/.zshrc — not executed, so no shebang.

# project shortcuts
notespath="$HOME/Code/dimitri-kandassamy/notes"
cookbookpath="$HOME/Code/dimitri-kandassamy/cookbook"
alias notes='code $notespath'
alias cookbook='code $cookbookpath'

# modern cli replacements
alias ls='eza --icons --group-directories-first'
alias ll='eza -la --icons --git'
alias lt='eza --tree --icons'
alias cat='bat --paging=never'
alias lg='lazygit'

# kubernetes shortcuts
alias k='kubectl'
alias kx='kubectx'
alias kns='kubens'
