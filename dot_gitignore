# Global gitignore — referenced by core.excludesfile in ~/.gitconfig.
# Only for things that are never worth committing in *any* repo; per-project
# noise belongs in that project's own .gitignore.

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Editors
# Not listed: .vscode/. A workspace settings.json is frequently a file the repo
# genuinely wants committed, so globally ignoring it is the same footgun as
# *.patch below.
.idea/
*.swp
*.un~
Session.vim
.netrwhist

# Local history / scratch
.history/
*.ignored/
*.ignored.*

# Anything named *.local is machine-local by convention
*.local

# Not listed: *.patch. Patch files are legitimate fixtures in some repos, and a
# global ignore is the hardest kind to debug when it silently swallows one.
# Ignore them per-project where that's actually true.

# Tool-local state
.direnv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
__pycache__/
node_modules/
.eslintcache
