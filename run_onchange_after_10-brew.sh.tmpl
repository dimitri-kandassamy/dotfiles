#!/usr/bin/env bash
# Installs every package in the Brewfile. Runs *after* the dotfiles are applied,
# so a package that fails to install can no longer leave $HOME without a shell
# config. Re-runs whenever the Brewfile changes, via the hash below.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

for prefix in /opt/homebrew /usr/local; do
  if [[ -x "$prefix/bin/brew" ]]; then
    eval "$("$prefix/bin/brew" shellenv)"
    break
  fi
done

# Homebrew 6 refuses to load formulae from non-official taps until they are
# trusted, and the trust list lives in machine-local ~/.homebrew/trust.json —
# so a fresh machine stalls on `brew bundle` without this. Read the taps out of
# the Brewfile so the two lists can't drift. Idempotent.
if brew trust --help &>/dev/null; then
  while IFS= read -r tap; do
    brew trust --tap "$tap"
  done < <(sed -n 's/^tap "\([^"]*\)".*/\1/p' "$BREWFILE")
fi

brew bundle --file="$BREWFILE"
