#!/usr/bin/env bash
# Installs every package in the Brewfile. Runs *after* the dotfiles are applied,
# so a package that fails to install can no longer leave $HOME without a shell
# config. Re-runs whenever the Brewfile changes, via the hash below.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile"

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

for prefix in /opt/homebrew /usr/local; do
  if [[ -x "$prefix/bin/brew" ]]; then
    eval "$("$prefix/bin/brew" shellenv)"
    break
  fi
done

# Homebrew 6 refuses to load formulae from non-official taps until they are
# trusted, and the trust list lives in machine-local ~/.homebrew/trust.json —
# so a fresh machine stalls on `brew bundle` without this. Read the taps out of
# the Brewfile so the two lists can't drift. Idempotent.
if brew trust --help &>/dev/null; then
  while IFS= read -r tap; do
    brew trust --tap "$tap"
  done < <(sed -n 's/^tap "\([^"]*\)".*/\1/p' "$BREWFILE")
fi

brew bundle --file="$BREWFILE"

# Docker CLI plugins. Docker Desktop used to supply compose and buildx; from
# Homebrew they land outside the directory the docker CLI searches, so link
# them into ~/.docker/cli-plugins. Idempotent.
plugin_dir="$(brew --prefix)/lib/docker/cli-plugins"
if [[ -d "$plugin_dir" ]]; then
  mkdir -p "$HOME/.docker/cli-plugins"
  for plugin in "$plugin_dir"/*; do
    [[ -e "$plugin" ]] && ln -sfn "$plugin" "$HOME/.docker/cli-plugins/$(basename "$plugin")"
  done
fi

# Clone the zsh plugins now rather than on the first interactive shell. Revisions
# come from the `rev` pins in plugins.toml, so this only fetches what those name.
if command -v sheldon &>/dev/null; then
  echo "Fetching sheldon plugins..."
  sheldon lock
fi

# Install the tool versions named in ~/.config/mise/config.toml, so the first
# shell after a fresh install already has node, python and go.
if command -v mise &>/dev/null; then
  echo "Installing mise tools..."
  mise install
fi
