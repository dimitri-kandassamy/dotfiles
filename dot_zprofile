# Login-shell environment. Runs before ~/.zshrc.

# Homebrew — nothing else puts brew on PATH, and on Apple Silicon
# /opt/homebrew/bin is not in /etc/paths. This has to happen before ~/.zshrc,
# which guards every tool behind `command -v`.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

# Editor. `code` comes from the visual-studio-code cask, which symlinks it into
# the Homebrew prefix; --wait blocks so git, kubectl edit, fc etc. work. Falls
# back to vi on a machine where VS Code isn't installed yet.
if command -v code &>/dev/null; then
  export EDITOR="code --wait"
else
  export EDITOR="vi"
fi
export VISUAL="$EDITOR"

# 1Password SSH agent — keys are served from the vault, never written to disk.
# ~/.ssh/config points ssh itself at the socket (so VS Code and other GUI apps
# work too); this covers tools that read SSH_AUTH_SOCK directly, e.g. `ssh-add -l`.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
