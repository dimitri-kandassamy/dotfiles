#!/usr/bin/env bash
# Re-runs whenever the rendered content changes — the Brewfile hash below
# means any Brewfile edit triggers a fresh `brew bundle`.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}

set -euo pipefail

if ! command -v brew &>/dev/null; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

BREW_PREFIX=$([[ "$(uname -m)" == "arm64" ]] && echo /opt/homebrew || echo /usr/local)
eval "$($BREW_PREFIX/bin/brew shellenv)"

brew bundle --no-lock --file="{{ .chezmoi.sourceDir }}/Brewfile"

bash "{{ .chezmoi.sourceDir }}/dot_macos"
