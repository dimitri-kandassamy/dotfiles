# Sheldon plugin manager (replaces Oh My Zsh)
command -v sheldon &>/dev/null && eval "$(sheldon source)"

# mise — polyglot version manager (Node, Python, Go, Terraform …)
command -v mise &>/dev/null && eval "$(mise activate zsh)"

# fzf shell integration (Ctrl+R, Ctrl+T, Alt+C)
command -v fzf &>/dev/null && source <(fzf --zsh)

# zoxide — smart cd with frecency tracking
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# Aliases
source "$HOME/.aliases"

# 1Password SSH agent — serves keys from the vault; no private keys on disk.
# Used for git/ssh authentication and SSH commit signing.
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Go — user-installed binaries (go install …)
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

# Flutter SDK (manual install at ~/DevTools/flutter)
[[ -d "$HOME/DevTools/flutter/bin" ]] && export PATH="$PATH:$HOME/DevTools/flutter/bin"

# Dart pub cache (mason CLI, etc.)
[[ -d "$HOME/.pub-cache/bin" ]] && export PATH="$PATH:$HOME/.pub-cache/bin"

# Android SDK (installed via Android Studio)
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools"
fi

# Dart CLI completion
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && source "$HOME/.dart-cli-completion/zsh-config.zsh"

# Terraform shell completion
if command -v terraform &>/dev/null; then
  autoload -U +X bashcompinit && bashcompinit
  complete -o nospace -C "$(which terraform)" terraform
fi

# Starship prompt (replaces Powerlevel10k) — keep last so it wraps the final shell state
command -v starship &>/dev/null && eval "$(starship init zsh)"
